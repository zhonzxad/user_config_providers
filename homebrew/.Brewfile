tap "farion1231/ccswitch"
tap "localsend/localsend"
# Automatic configure script builder
brew "autoconf"
# Cryptography and SSL/TLS Toolkit
brew "openssl@3", link: true
# Shell extension to jump to frequently used directories
brew "autojump"
# Tool for generating GNU Standards-compliant Makefiles
brew "automake"
# Dependency manager for Cocoa projects
brew "cocoapods"
# GNU File, Shell, and Text utilities
brew "coreutils"
# Distributed revision control system
brew "git"
# Assuan IPC Library
brew "libassuan@2"
# X.509 and CMS library
brew "libksba"
# Generic library support script
brew "libtool"
# Utility for directing compilation
brew "make"
# Open-source, cross-platform JavaScript runtime environment
brew "node"
# Cryptography and SSL/TLS Toolkit
brew "openssl@1.1"
# Pinentry for GPG on Mac
brew "pinentry-mac"
# Package compiler and linker metadata toolkit
brew "pkgconf"
# Fast, disk space efficient package manager
brew "pnpm"
# Extremely fast Python package installer and resolver, written in Rust
brew "uv"
# Internet file retriever
brew "wget"
# General-purpose lossless data-compression library
brew "zlib"
# Fish-like fast/unobtrusive autosuggestions for zsh
brew "zsh-autosuggestions"
# Additional completion definitions for zsh
brew "zsh-completions"
# Android SDK component
cask "android-platform-tools"
# User-friendly GUI app for Homebrew
cask "applite"
# Configuration manager for AI coding agents
cask "cc-switch"
# Desktop client that supports multiple LLM providers
cask "cherry-studio"
# OpenAI's coding agent that runs in your terminal
cask "codex"
# App to build and share containerised applications and microservices
cask "docker-desktop"
# Project management software
cask "feishu"
cask "font-google-sans"
cask "font-google-sans-code"
cask "font-sauce-code-pro-nerd-font"
# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"
# Xcode extension for GitHub Copilot
cask "github-copilot-for-xcode"
# Web browser
cask "google-chrome"
# Utility to hide menu bar items
cask "hiddenbar"
# Homebrew's official GUI
cask "homebrew-app"
# Free cross-platform office suite, fresh version
cask "libreoffice"
cask "localsend"
# Multi-platform web browser
cask "microsoft-edge"
# App to write, plan, collaborate, and get organised
cask "notion"
# Utility to uninstall apps and remove leftover files from old/uninstalled apps
cask "pearcleaner"
