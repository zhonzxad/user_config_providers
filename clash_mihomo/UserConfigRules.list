# 本地/局域网地址
# 参考：https://en.wikipedia.org/wiki/Reserved_IP_addresses

# ACL4SSR标志 如没有，代表不是用ACL4SSR规则
DOMAIN-SUFFIX,acl4.ssr

# 自定义规则
# DOMAIN-KEYWORD,ip.sb
# DOMAIN-KEYWORD,ipwho.is
# DOMAIN-KEYWORD,ipapi.is
# DOMAIN-KEYWORD,ipip.net
DOMAIN-SUFFIX,aarr.cc
DOMAIN-SUFFIX,baidu.com
DOMAIN-REGEX,ip.sb          
DOMAIN-REGEX,ipwho.is             
DOMAIN-REGEX,ipapi.is             
DOMAIN-REGEX,ipip.net

# Adguard 规则
DOMAIN-KEYWORD,adguard-dns.io
DOMAIN-KEYWORD,adguard-dns.com
